---
interface Props {
  questions: Array<{
    question: string;
    answer: string;
  }>;
}

const { questions } = Astro.props;
---

<section class="space-y-4">
  <h2 class="text-2xl font-bold">FAQ</h2>
  <div class="divide-y divide-line rounded-lg border border-line bg-white">
    {
      questions.map((item) => (
        <details class="group p-5">
          <summary class="cursor-pointer list-none font-semibold">
            {item.question}
          </summary>
          <p class="mt-3 text-sm text-muted">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
