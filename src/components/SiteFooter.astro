---
import { affiliateConfig } from "@/config/affiliate.config";
import { siteConfig } from "@/config/site.config";
import { categories } from "@/data/categories";

const footerCategories = siteConfig.categoryNavSlugs
  .map((slug) => categories.find((category) => category.slug === slug))
  .filter(Boolean);
---

<footer class="border-t-4 border-ink bg-paper">
  <div class="container grid gap-8 py-12 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
    <section>
      <h2 class="text-xl font-bold">{siteConfig.name}</h2>
      <p class="mt-3 max-w-sm text-sm leading-6 text-muted">
        {siteConfig.trust.promise}
      </p>
      <p class="mt-4 text-xs leading-5 text-muted">
        {affiliateConfig.disclosureShort}
      </p>
    </section>
    <section>
      <h2 class="text-sm font-bold">Start here</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/best/">Best picks</a></li>
        <li><a href="/guides/">Buying guides</a></li>
        <li><a href="/compare/">Comparisons</a></li>
        <li><a href="/reviews/">Reviews</a></li>
        <li><a href="/brands/">Browse brands</a></li>
      </ul>
    </section>
    <section>
      <h2 class="text-sm font-bold">Categories</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          footerCategories.map((category) => (
            <li>
              <a href={`/categories/${category!.slug}/`}>{category!.name}</a>
            </li>
          ))
        }
        <li><a href="/categories/">View all</a></li>
      </ul>
    </section>
    <section>
      <h2 class="text-sm font-bold">About & standards</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/review-methodology/">Review methodology</a></li>
        <li><a href="/editorial-policy/">Editorial policy</a></li>
        <li><a href="/ai-transparency/">AI transparency</a></li>
        <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </section>
  </div>
  <div class="border-t border-line">
    <div
      class="container flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:justify-between"
    >
      <span>© {new Date().getFullYear()} {siteConfig.name}</span>
      <span><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
    </div>
  </div>
</footer>
