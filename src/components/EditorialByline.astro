---
import { siteConfig } from "@/config/site.config";

interface Props {
  dateModified: string;
  contentType: "review" | "guide" | "comparison" | "best";
}

const { dateModified, contentType } = Astro.props;
const label = {
  review: "Editorial buying review",
  guide: "Editorial buying guide",
  comparison: "Editorial comparison",
  best: "Editorial format guide",
}[contentType];
---

<p class="mt-3 text-sm text-muted">
  {label} · Updated <time datetime={dateModified}>{dateModified}</time> · By
  <a class="text-link" href="/about/">{siteConfig.author.name}</a> ·
  <a class="text-link" href="/editorial-policy/">Editorial policy</a> ·
  <a class="text-link" href="/review-methodology/">Methodology</a>
</p>
