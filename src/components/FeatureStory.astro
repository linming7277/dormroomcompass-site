---
import EvidenceBadge from "@/components/EvidenceBadge.astro";
import type { Category, Product } from "@/types";
import { getProductReview, getProductReadingPath } from "@/utils/data";

interface Props {
  product: Product;
  category: Category;
}

const { product, category } = Astro.props;
const review = getProductReview(product.slug);
const readingPath = getProductReadingPath(product.slug);
---

<article
  class="grid overflow-hidden border border-line bg-surface md:grid-cols-[minmax(0,1.35fr)_minmax(22rem,0.65fr)]"
>
  {
    product.image && (
      <img
        class="h-full min-h-72 w-full object-cover"
        src={product.image}
        alt={`${product.name} product preview`}
        width="960"
        height="720"
      />
    )
  }
  <div class="flex flex-col justify-center p-6 md:p-8 xl:p-10">
    <div class="flex flex-wrap gap-2">
      {product.award && <span class="award-chip">{product.award.label}</span>}
      <EvidenceBadge evidence={product.evidence} />
    </div>
    <p class="mt-5 text-sm font-bold text-accent">{category.name}</p>
    <h2 class="mt-2 text-3xl font-bold leading-tight">
      <a class="text-ink no-underline hover:text-brand" href={readingPath}>{product.name}</a>
    </h2>
    <p class="mt-3 leading-7 text-muted">
      {product.bestFor}
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a class="button-secondary" href={readingPath}>
        {review ? "Read review" : "Read buying guide"}
      </a>
    </div>
  </div>
</article>
