---
import type { Category, Product } from "@/types";
import { getProductReview, getProductReadingPath } from "@/utils/data";

interface Props {
  category: Category;
  products: Product[];
}

const { category, products } = Astro.props;
---

<section class="border-t-4 border-ink pt-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-3xl font-bold leading-tight">
        <a
          class="text-ink no-underline hover:text-brand"
          href={`/categories/${category.slug}/`}>{category.name}</a
        >
      </h2>
      <p class="mt-1 max-w-4xl text-muted">{category.description}</p>
    </div>
    <a class="text-link shrink-0" href={`/categories/${category.slug}/`}
      >See category →</a
    >
  </div>

  <div class="mt-5 grid gap-5 md:grid-cols-3">
    {
      products.map((product, index) => (
        <article
          class:list={[
            "group",
            index > 0 &&
              "border-t border-line pt-5 md:border-l md:border-t-0 md:pl-5 md:pt-0",
          ]}
        >
          <div class="block text-ink no-underline hover:no-underline">
            {
              product.image && (
                <img
                  class="aspect-[16/9] w-full bg-white object-contain p-3"
                  src={product.image}
                  alt={`${product.name} product preview`}
                  width="640"
                  height="360"
                  loading="lazy"
                />
              )
            }
            <p class="mt-3 text-xs font-bold text-accent">
              {product.award?.label || "Product review"}
            </p>
            <h3 class="mt-1 text-xl font-bold leading-tight group-hover:text-brand">
              <a class="text-ink no-underline hover:text-brand" href={getProductReadingPath(product.slug)}>{product.name}</a>
            </h3>
            <p class="mt-2 text-sm leading-6 text-muted">
              {product.bestFor}
            </p>
            <div class="mt-3 flex flex-wrap gap-3">
              <a class="text-link" href={getProductReadingPath(product.slug)}>
                {getProductReview(product.slug) ? "Read review →" : "Read buying guide →"}
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
