---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categories } from "@/data/categories";
import { siteConfig } from "@/config/site.config";
---

<BaseLayout
  title={`Product Categories - ${siteConfig.name}`}
  description="Browse category hubs built from product-library data, keyword evidence, and buyer-intent notes."
  canonicalPath="/categories/"
>
  <section class="container section space-y-8">
    <header class="max-w-4xl border-b-4 border-ink pb-6">
      <p class="section-label">Category directory</p>
      <h1 class="page-heading mt-2">Product Categories</h1>
      <p class="text-lg text-muted">
        Use categories to map commercial keywords into best-pick, review,
        comparison, and guide pages without publishing duplicate thin pages.
      </p>
    </header>
    <div class="divide-y divide-line border-y border-line">
      {
        categories.map((category) => (
          <a
            href={`/categories/${category.slug}/`}
            class="grid gap-3 py-6 text-ink no-underline hover:text-brand hover:no-underline md:grid-cols-[0.8fr_1.2fr]"
          >
            <h2 class="text-2xl font-bold">{category.name}</h2>
            <span>
              <>
                <span class="block leading-7 text-muted">
                  {category.description}
                </span>
                <span class="mt-2 block text-sm font-bold text-accent">
                  {category.recommendedProductSlugs.length} product records ·{" "}
                  {category.searchIntent} intent
                </span>
              </>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
