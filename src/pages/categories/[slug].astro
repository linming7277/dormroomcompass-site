---
import AffiliateDisclosure from "@/components/AffiliateDisclosure.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ProductCard from "@/components/ProductCard.astro";
import PageSources from "@/components/PageSources.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { categories } from "@/data/categories";
import { assertFound, getCategory, getProductsByCategory } from "@/utils/data";
import { breadcrumbSchema, itemListSchema, jsonLd } from "@/utils/schema";

export function getStaticPaths() { return categories.map((category) => ({ params: { slug: category.slug } })); }

const category = assertFound(getCategory(Astro.params.slug || ""), "Category");
const categoryProducts = getProductsByCategory(category.slug);
const guides = await getCollection("guides");
const bestPicks = await getCollection("bestPicks");
const comparisons = await getCollection("comparisons");
const reviews = await getCollection("reviews");
const categoryGuides = guides.filter((guide) => guide.data.categorySlug === category.slug);
const categoryBestPick = bestPicks.find((pick) => pick.data.categorySlug === category.slug);
const categoryComparisons = comparisons.filter((comparison) => comparison.data.productSlugs.some((slug) => categoryProducts.some((product) => product.slug === slug)));
const categoryReviews = reviews.filter((review) => categoryProducts.some((product) => product.slug === review.data.productSlug));
const subcategories = (category.subcategorySlugs || []).map((slug) => getCategory(slug)).filter(Boolean);
const breadcrumbs = [{ name: "Home", url: "/" }, { name: "Categories", url: "/categories/" }, { name: category.name, url: `/categories/${category.slug}/` }];
---

<BaseLayout title={category.title} description={category.description} canonicalPath={`/categories/${category.slug}/`}>
  <header class="border-b border-line bg-paper"><div class="container py-10 md:py-14"><Breadcrumbs items={breadcrumbs} /><div class="mt-7 max-w-4xl"><p class="section-kicker">Product category</p><h1 class="page-heading mt-3">{category.title}</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-muted">{category.description}</p></div></div></header>
  <div class="container space-y-14 py-12 md:py-16">
    {subcategories.length > 0 && <nav class="wide-column" aria-label={`${category.name} subcategories`}><p class="section-kicker">Browse this category</p><div class="mt-4 flex flex-wrap gap-2">{subcategories.map((subcategory) => <a class="button-secondary" href={`/categories/${subcategory!.slug}/`}>{subcategory!.name}</a>)}</div></nav>}
    <section class="wide-column grid gap-6 border-y-2 border-ink py-8 md:grid-cols-[0.8fr_1.2fr]"><div><p class="section-kicker">Start with the problem</p><h2 class="mt-2 text-3xl font-bold">What this category should help you decide.</h2></div><div><p class="leading-7 text-muted">{category.buyerIntent}</p><p class="mt-3 text-sm leading-6 text-muted">Start with a guide or comparison when the role is unclear. Browse individual products only after the decision is narrower.</p></div></section>

    {categoryGuides.length > 0 && <section class="wide-column"><div class="flex items-end justify-between gap-4"><div><p class="section-kicker">Featured buying guides</p><h2 class="mt-2 text-3xl font-bold">Build the decision before adding a product.</h2></div><a class="text-link" href="/guides/">All guides →</a></div><div class="mt-7 grid gap-5 md:grid-cols-2">{categoryGuides.map((guide) => <a class="editorial-card no-underline" href={`/guides/${guide.data.slug}/`}><p class="section-kicker">Buying guide</p><h3 class="mt-2 text-xl font-bold text-ink">{guide.data.title}</h3><p class="mt-3 text-sm leading-6 text-muted">{guide.data.description}</p><span class="mt-5 inline-block text-sm font-bold text-brand">Read guide →</span></a>)}</div></section>}

    {categoryBestPick && <section class="wide-column"><p class="section-kicker">Best picks</p><h2 class="mt-2 text-3xl font-bold">A shortlist with a no-buy path.</h2><a class="editorial-card mt-7 block no-underline" href={`/best/${categoryBestPick.data.slug}/`}><h3 class="text-2xl font-bold text-ink">{categoryBestPick.data.title}</h3><p class="mt-3 leading-7 text-muted">{categoryBestPick.data.description}</p><span class="mt-5 inline-block text-sm font-bold text-brand">Compare the picks →</span></a></section>}

    {categoryComparisons.length > 0 && <section class="wide-column"><p class="section-kicker">Comparisons</p><h2 class="mt-2 text-3xl font-bold">When the decision is between formats.</h2><div class="mt-7 grid gap-5 md:grid-cols-2">{categoryComparisons.map((comparison) => <a class="editorial-card no-underline" href={`/compare/${comparison.data.slug}/`}><p class="section-kicker">Side-by-side decision</p><h3 class="mt-2 text-xl font-bold text-ink">{comparison.data.title}</h3><p class="mt-3 text-sm leading-6 text-muted">{comparison.data.description}</p><span class="mt-5 inline-block text-sm font-bold text-brand">See decision paths →</span></a>)}</div></section>}

    {categoryReviews.length > 0 && <section class="wide-column"><p class="section-kicker">Latest reviews</p><h2 class="mt-2 text-3xl font-bold">Read product context before the listing.</h2><div class="mt-7 grid gap-5 md:grid-cols-2">{categoryReviews.map((review) => <a class="editorial-card no-underline" href={`/reviews/${review.data.productSlug}/`}><p class="section-kicker">Editorial review</p><h3 class="mt-2 text-xl font-bold text-ink">{review.data.title}</h3><p class="mt-3 text-sm leading-6 text-muted">{review.data.decision.headline}</p><span class="mt-5 inline-block text-sm font-bold text-brand">Read review →</span></a>)}</div></section>}

    <section class="wide-column border-t border-line pt-10"><div class="flex items-end justify-between gap-4"><div><p class="section-kicker">Browse products</p><h2 class="mt-2 text-3xl font-bold">Product records to explore last.</h2></div><AffiliateDisclosure compact /></div><p class="mt-3 max-w-3xl leading-7 text-muted">These records identify listing questions and source-backed context. They do not create a performance ranking.</p><div class="mt-7 grid gap-5 md:grid-cols-2">{categoryProducts.map((product) => <ProductCard product={product} />)}</div></section>
    <section class="wide-column"><PageSources sourceUrls={category.sourceUrls} /></section>
  </div>
  <script is:inline type="application/ld+json" set:html={jsonLd(itemListSchema(category, categoryProducts))} />
  <script is:inline type="application/ld+json" set:html={jsonLd(breadcrumbSchema(breadcrumbs))} />
</BaseLayout>
