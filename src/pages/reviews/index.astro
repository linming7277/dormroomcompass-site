---
import ProductCard from "@/components/ProductCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { products } from "@/data/products";
import { getCollection } from "astro:content";
import { siteConfig } from "@/config/site.config";

const reviews = await getCollection("reviews");
---

<BaseLayout
  title={`Reviews - ${siteConfig.name}`}
  description="Editorial buying reviews with clear source limits, tradeoffs, and a decision-first path to current listings."
  canonicalPath="/reviews/"
>
  <section class="container section space-y-8">
    <header class="max-w-4xl border-b-4 border-ink pb-6">
      <p class="section-label">Product research</p>
      <h1 class="page-heading mt-2">Editorial Buying Reviews</h1>
      <p class="text-lg text-muted">
        This site does not publish individual review claims without adequate
        evidence. Browse editorial reviews, tradeoffs, and current-listing checks.
      </p>
    </header>
    <div class="grid gap-5 md:grid-cols-2">
      {
        reviews.map((review) => {
          const product = products.find((item) => item.slug === review.data.productSlug);
          return product ? <ProductCard product={product} /> : null;
        })
      }
    </div>
  </section>
</BaseLayout>
