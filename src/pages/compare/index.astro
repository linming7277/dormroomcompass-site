---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "@/config/site.config";

const comparisons = await getCollection("comparisons");
---

<BaseLayout
  title={`Product Comparisons - ${siteConfig.name}`}
  description="Editorial comparisons for buyer decisions that need clear dimensions, tradeoffs, and a no-buy path."
  canonicalPath="/compare/"
>
  <section class="container section space-y-8">
    <header class="max-w-4xl border-b-4 border-ink pb-6">
      <p class="section-label">Side-by-side decisions</p>
      <h1 class="page-heading mt-2">Product Comparisons</h1>
      <p class="text-lg text-muted">
        Compare decision dimensions first, then read the individual product
        context before verifying a current listing.
      </p>
    </header>
    <div class="divide-y divide-line border-y border-line">
      {
        comparisons.map((comparison) => (
          <a
            href={`/compare/${comparison.data.slug}/`}
            class="grid gap-3 py-6 text-ink no-underline hover:text-brand hover:no-underline md:grid-cols-[0.9fr_1.1fr]"
          >
            <h2 class="text-2xl font-bold leading-tight">{comparison.data.title}</h2>
            <span class="leading-7 text-muted">{comparison.data.description}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
