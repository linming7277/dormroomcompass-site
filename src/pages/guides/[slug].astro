---
import AffiliateDisclosure from "@/components/AffiliateDisclosure.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import EditorialByline from "@/components/EditorialByline.astro";
import FAQSection from "@/components/FAQSection.astro";
import ProductCard from "@/components/ProductCard.astro";
import PageSources from "@/components/PageSources.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import {
  assertFound,
  getCategory,
  getProductsByCategory,
  getProduct,
} from "@/utils/data";
import {
  articleSchema,
  breadcrumbSchema,
  faqSchema,
  jsonLd,
} from "@/utils/schema";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({
    params: { slug: guide.data.slug },
  }));
}

const guide = assertFound(
  await getEntry("guides", Astro.params.slug || ""),
  "Buying guide",
);
const category = assertFound(getCategory(guide.data.categorySlug), "Category");
const guideProducts = guide.data.productSlugs
  ? guide.data.productSlugs.flatMap((slug) => {
      const product = getProduct(slug);
      return product ? [product] : [];
    })
  : getProductsByCategory(category.slug);
const comparisons = await getCollection("comparisons");
const bestPicks = await getCollection("bestPicks");
const guideProductSlugs = new Set(guideProducts.map((product) => product.slug));
const relatedComparisons = comparisons.filter((comparison) =>
  comparison.data.productSlugs.some((slug) => guideProductSlugs.has(slug)),
);
const relatedBestPicks = bestPicks.filter((bestPick) =>
  bestPick.data.productSlugs.some((slug) => guideProductSlugs.has(slug)),
);
const { Content } = await render(guide);
const guideHeroProduct = guideProducts[0];
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Guides", url: "/guides/" },
  { name: guide.data.title, url: `/guides/${guide.data.slug}/` },
];
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  canonicalPath={`/guides/${guide.data.slug}/`}
>
  <article>
    <header class="border-b border-line bg-paper"><div class="container py-10 md:py-14"><Breadcrumbs items={breadcrumbs} /><div class="mt-7 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end"><div class="max-w-4xl"><p class="section-kicker">Buying guide</p><h1 class="page-heading mt-3">{guide.data.title}</h1><p class="mt-5 text-lg leading-8 text-muted">{guide.data.description}</p><EditorialByline dateModified={guide.data.dateModified} contentType="guide" /></div>{guideHeroProduct && <img src={guideHeroProduct.image} alt={`${guideHeroProduct.name} product format referenced in this guide`} width="800" height="600" class="aspect-[4/3] w-full border border-line object-cover" />}</div><div class="mt-6 max-w-4xl"><AffiliateDisclosure compact /></div></div></header>
    <div class="container space-y-12 py-12 md:py-16">
    <nav class="wide-column border-y border-line py-5" aria-label="Guide navigation"><p class="section-kicker">In this guide</p><div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-bold"><a href="#guide-content">Core guide</a><a href="#product-path">Product-selection path</a>{(relatedComparisons.length > 0 || relatedBestPicks.length > 0) && <a href="#related-content">Related decisions</a>}{guide.data.questions?.length ? <a href="#faq">Questions</a> : null}</div></nav>
    <div id="guide-content" class="article-column prose-affiliate">
      <Content />
    </div>
    <section id="product-path" class="wide-column space-y-4">
      <p class="section-kicker">Product-selection path</p><h2 class="text-3xl font-bold">Products referenced in this guide</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {guideProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </section>
    {(relatedComparisons.length > 0 || relatedBestPicks.length > 0) && (
      <section id="related-content" class="wide-column">
        <p class="section-kicker">Related commercial content</p><h2 class="mt-2 text-3xl font-bold">Continue the decision</h2>
        <p class="mt-3 max-w-4xl text-muted">
          Use a comparison when the choice is between formats, or a format guide when you need to see the tradeoffs before reading an individual listing.
        </p>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          {relatedComparisons.map((comparison) => (
            <a class="border-t border-line pt-4 text-ink no-underline hover:text-brand" href={`/compare/${comparison.data.slug}/`}>
              <span class="text-sm font-bold text-accent">Comparison</span>
              <span class="mt-1 block text-xl font-bold leading-tight">{comparison.data.title}</span>
              <span class="mt-2 block text-sm leading-6 text-muted">{comparison.data.description}</span>
            </a>
          ))}
          {relatedBestPicks.map((bestPick) => (
            <a class="border-t border-line pt-4 text-ink no-underline hover:text-brand" href={`/best/${bestPick.data.slug}/`}>
              <span class="text-sm font-bold text-accent">Format guide</span>
              <span class="mt-1 block text-xl font-bold leading-tight">{bestPick.data.title}</span>
              <span class="mt-2 block text-sm leading-6 text-muted">{bestPick.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <section class="wide-column"><PageSources sourceUrls={guide.data.sourceUrls} /></section>
    <section id="faq" class="wide-column"><FAQSection questions={guide.data.questions ?? []} /></section>
    </div>
  </article>
  <script
    is:inline
    type="application/ld+json"
    set:html={jsonLd(articleSchema(guide.data))}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={jsonLd(faqSchema(guide.data.questions || []))}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={jsonLd(breadcrumbSchema(breadcrumbs))}
  />
</BaseLayout>
