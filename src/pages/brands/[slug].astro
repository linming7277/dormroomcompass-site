---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ProductCard from "@/components/ProductCard.astro";
import PageSources from "@/components/PageSources.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { brands } from "@/data/brands";
import { assertFound, getBrand, getProductsByBrand } from "@/utils/data";
import { breadcrumbSchema, jsonLd } from "@/utils/schema";

export function getStaticPaths() {
  return brands.map((brand) => ({
    params: { slug: brand.slug },
  }));
}

const brand = assertFound(getBrand(Astro.params.slug || ""), "Brand");
const brandProducts = getProductsByBrand(brand.slug);
const reviews = await getCollection("reviews");
const guides = await getCollection("guides");
const comparisons = await getCollection("comparisons");
const brandProductSlugs = new Set(brandProducts.map((product) => product.slug));
const brandReviews = reviews.filter((review) =>
  brandProductSlugs.has(review.data.productSlug),
);
const relatedGuides = guides.filter((guide) =>
  guide.data.productSlugs?.some((slug) => brandProductSlugs.has(slug)),
);
const relatedComparisons = comparisons.filter((comparison) =>
  comparison.data.productSlugs.some((slug) => brandProductSlugs.has(slug)),
);
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Brands", url: "/brands/" },
  { name: brand.name, url: `/brands/${brand.slug}/` },
];
---

<BaseLayout
  title={`${brand.name} Product Guides and Buying Notes`}
  description={brand.description}
  canonicalPath={`/brands/${brand.slug}/`}
>
  <section class="container section space-y-12">
    <Breadcrumbs items={breadcrumbs} />
    <header class="max-w-3xl space-y-4">
      <p class="section-kicker">Brand hub</p>
      <h1 class="page-heading mt-2">{brand.name} Product Guides and Buying Notes</h1>
      <p class="text-lg text-muted">{brand.description}</p>
      {
        brand.website && (
          <a href={brand.website} target="_blank" rel="nofollow noopener">
            Official website
          </a>
        )
      }
    </header>

    <section class="grid gap-6 border-y border-line py-6 md:grid-cols-[0.8fr_1.2fr]">
      <div>
        <p class="section-label">How to use this hub</p>
        <h2 class="mt-1 text-2xl font-bold">Start with a buyer question</h2>
      </div>
      <p class="leading-7 text-muted">
        A brand hub is not a recommendation to buy every item from one maker.
        Use it to find the product format that matches a defined buyer role,
        then read the relevant review or buying guide before checking a listing.
      </p>
    </section>

    {(brandReviews.length > 0 || relatedGuides.length > 0 || relatedComparisons.length > 0) && (
      <section>
        <p class="section-kicker">Start with editorial context</p>
        <h2 class="mt-2 text-3xl font-bold">Read the decision before the product record.</h2>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          {brandReviews.map((review) => (
            <a class="border-t border-line pt-4 text-ink no-underline hover:text-brand" href={`/reviews/${review.data.productSlug}/`}>
              <span class="text-sm font-bold text-accent">Review</span>
              <span class="mt-1 block text-xl font-bold leading-tight">{review.data.title}</span>
              <span class="mt-2 block text-sm leading-6 text-muted">{review.data.description}</span>
            </a>
          ))}
          {relatedGuides.map((guide) => (
            <a class="border-t border-line pt-4 text-ink no-underline hover:text-brand" href={`/guides/${guide.data.slug}/`}>
              <span class="text-sm font-bold text-accent">Buying guide</span>
              <span class="mt-1 block text-xl font-bold leading-tight">{guide.data.title}</span>
              <span class="mt-2 block text-sm leading-6 text-muted">{guide.data.description}</span>
            </a>
          ))}
          {relatedComparisons.map((comparison) => (
            <a class="border-t border-line pt-4 text-ink no-underline hover:text-brand" href={`/compare/${comparison.data.slug}/`}>
              <span class="text-sm font-bold text-accent">Comparison</span>
              <span class="mt-1 block text-xl font-bold leading-tight">{comparison.data.title}</span>
              <span class="mt-2 block text-sm leading-6 text-muted">{comparison.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section>
      <p class="section-kicker">Browse products</p>
      <h2 class="mt-2 text-3xl font-bold">Product records come last.</h2>
      <p class="mt-3 max-w-4xl text-muted">
        These product cards identify current listing questions and link to on-site editorial context. They do not rank the brand's catalog or make a product-performance claim.
      </p>
    <div class="grid gap-6 md:grid-cols-2">
      {brandProducts.map((product) => <ProductCard product={product} />)}
    </div>
    </section>
    <PageSources sourceUrls={brand.sourceUrls} />
  </section>
  <script
    is:inline
    type="application/ld+json"
    set:html={jsonLd(breadcrumbSchema(breadcrumbs))}
  />
</BaseLayout>
